{
  "expo": {
    "name": "CLSR Studio",
    "slug": "clsr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clsr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CLSR uses the camera to photograph your floor plan.",
        "NSPhotoLibraryUsageDescription": "CLSR needs access to your photos to import floor plans and save renders.",
        "NSLocalNetworkUsageDescription": "CLSR Studio connects to your CLSR server on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0E0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clsr.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0F0E0C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CLSR needs access to your photos to import floor plans.",
          "cameraPermission": "CLSR uses the camera to photograph your floor plan."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "clsr",
    "backgroundColor": "#0F0E0C"
  }
}
